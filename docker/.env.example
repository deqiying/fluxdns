# FluxDNS 容器部署环境变量模板。
#
# 使用方式：复制为 docker/.env（该文件已在 .gitignore 中），再按实际情况修改。
# 同一份 .env 承担两种作用：
# 1. Compose 变量替换：镜像引用、宿主工作目录、端口映射；
# 2. 容器环境变量注入：config.yaml 中 SecretRef 声明的 env 名称。

# 镜像引用：示例跟随 latest，便于复制后直接拉取；需要可复现部署时替换为具体版本 tag。
FLUXDNS_IMAGE=ghcr.io/deqiying/fluxdns:latest

# 宿主工作目录：必须预先存在并包含 config.yaml（配置内 work.path 为 /etc/fluxdns）。
FLUXDNS_WORK_DIR=/srv/fluxdns

# 端口映射：53/443 需要宿主端口未被占用。
FLUXDNS_DNS_PORT=53
FLUXDNS_DOH_PORT=443
FLUXDNS_WEBUI_BIND=127.0.0.1
FLUXDNS_WEBUI_PORT=8080

# SecretRef 示例：名称必须与 config.yaml 中 outbound.proxy_url.env 一致。
# 含凭据的文件不得提交；也可以改用 Compose secrets 并在配置里使用 file 来源。
# FLUXDNS_OUTBOUND_SG_URL=socks5://user:password@proxy.example:1080
